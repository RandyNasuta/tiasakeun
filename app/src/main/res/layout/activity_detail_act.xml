<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_act"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.view.DetailActActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSubActivityProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            android:backgroundTint="@color/window_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sub_activity"
                    app:boxStrokeColor="@color/accent_blue"
                    app:hintTextColor="@color/accent_blue"
                    android:layout_marginBottom="20dp">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/spSubActivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:text="@string/sub_activity"
                        android:textColor="@color/primary_text"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/llQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:id="@+id/tvProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2000/4000 meter"
                            android:layout_gravity="center"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text" />

                        <TextView
                            android:id="@+id/tvPercentProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50%"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue"/>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/total"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp"
                        app:boxStrokeColor="@color/accent_blue"
                        app:hintTextColor="@color/accent_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etQuantityTotalProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="9"
                            android:textColor="@color/primary_text"
                            android:imeOptions="actionDone"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/cpTimber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:indicatorSize="220dp"
                            app:trackThickness="12dp"
                            app:trackCornerRadius="7dp"
                            android:max="100"
                            android:indeterminate="false"
                            android:progress="100"
                            app:indicatorColor="@color/accent_blue"
                            app:trackColor="#E0E0E0"/>

                        <TextView
                            android:id="@+id/tvTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="12:00"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetTimer"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:iconGravity="textStart"
                            app:icon="@drawable/outline_autostop_24"
                            app:iconTint="@color/primary_text"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlayPauseTimer"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginStart="24dp"
                            android:gravity="center"
                            android:backgroundTint="@color/accent_blue"
                            app:icon="@drawable/outline_autoplay_24"
                            app:iconSize="32dp"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoSubActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/data_activity_does_not_exist"
                    android:textSize="16sp"
                    android:layout_marginVertical="50dp"
                    android:textColor="@color/primary_text"
                    android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/finish"
                    android:backgroundTint="@color/accent_blue"
                    android:layout_gravity="center"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A000000"
            android:layout_marginVertical="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            android:backgroundTint="@color/window_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_report"
                    android:textSize="@dimen/text_size_title_medium"
                    android:textColor="@color/primary_text"
                    android:layout_marginBottom="20dp"
                    android:layout_gravity="center"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/btnToggleDays"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@+id/btnOneDay"
                        android:layout_weight="1.25"
                        android:layout_marginEnd="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOneDay"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/accent_blue"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:textSize="12sp"
                            android:maxLines="1"
                            app:cornerRadius="10dp"
                            android:text="@string/one_day"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOneWeek"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/accent_blue"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:text="@string/one_week"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOneMonth"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/accent_blue"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:text="@string/one_month"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThreeMonths"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/accent_blue"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:text="@string/three_month"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOnYear"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/accent_blue"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:textSize="12sp"
                            android:maxLines="1"
                            app:cornerRadius="10dp"
                            android:text="@string/one_year"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAllTime"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/accent_blue"
                            android:minWidth="0dp"
                            android:paddingVertical="0dp"
                            android:paddingRight="0dp"
                            android:paddingLeft="8dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:textSize="12sp"
                            android:maxLines="1"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/baseline_dehaze_24"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_weight="0.75">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            app:boxStrokeColor="@color/accent_blue"
                            app:hintTextColor="@color/accent_blue">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/spSortSubActivity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:text="@string/sorting"
                                android:textColor="@color/primary_text"/>
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1A000000"
                    android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReportSubAcivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>