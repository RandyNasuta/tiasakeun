<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvSubActivity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_medium"
        android:textColor="@color/primary_text"
        android:layout_weight="1"
        android:layout_margin="8dp"
        android:text="@string/reading_a_book"
        android:layout_gravity="center"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvSubActivityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_body_medium"
            android:textColor="@color/primary_text"
            android:layout_weight="1"
            android:text="@string/sixty_minutes"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#808080"/>

        <TextView
            android:id="@+id/tvSubActivityDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_body_medium"
            android:textColor="@color/primary_text"
            android:layout_weight="1"
            android:text="@string/example_date"/>
    </LinearLayout>
</LinearLayout>