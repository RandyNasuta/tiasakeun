<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:layout_gravity="center_horizontal">

        <TextView
            android:id="@+id/tvTitleDialogSubActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_activity"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="20dp"
            android:gravity="center_horizontal"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/title"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="@color/accent_blue"
            app:hintTextColor="@color/accent_blue">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etActivityTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/primary_text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/type"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="@color/accent_blue"
            app:hintTextColor="@color/accent_blue"
            android:visibility="gone">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spinnerType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/primary_text"/>

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/llTargetValueQuantity"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTotalMinus"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/outline_minus_24"
                app:iconTint="@color/white"
                android:backgroundTint="@color/accent_blue"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/target"
                android:layout_marginHorizontal="4dp"
                app:boxStrokeColor="@color/accent_blue">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="0"
                    android:gravity="center"
                    android:textColor="@color/primary_text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTotalPlus"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/outline_add_24"
                app:iconTint="@color/white"
                android:backgroundTint="@color/accent_blue"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelEditActivity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textColor="@color/black"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/accent_blue"
                app:strokeWidth="2dp"
                android:paddingHorizontal="24dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="5dp"
                tools:ignore="MissingConstraints"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateActivity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/update"
                android:backgroundTint="@color/accent_blue"
                android:paddingHorizontal="24dp"
                android:layout_marginBottom="8dp"
                tools:ignore="MissingConstraints"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>