<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.view.MainActivity"
    android:background="@color/window_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/llNoData"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvNoDataActivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_activity_data_exists"
                android:textSize="@dimen/text_size_title_medium"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/tvNoDataActivity2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:text="Buat baru untuk mulai \n mengatur aktivitas"
                android:textSize="@dimen/text_size_body_large"
                android:textColor="@color/text_gray"
                android:layout_gravity="center"/>
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rVActiviy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:src="@drawable/outline_add_24"
            android:layout_margin="16dp"
            android:backgroundTint="@color/accent_blue"
            android:contentDescription="@string/add_new_activity"
            android:tint="@color/white"/>
    </FrameLayout>


</LinearLayout>